generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("customer")
  password  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enquiries  Enquiry[]
  projects   Project[]
}

model Enquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  location     String?
  propertyType String?
  buildingArea String?
  message      String?
  status       String   @default("new")
  userId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
}

model Project {
  id            String   @id @default(cuid())
  projectId     String   @unique
  name          String?
  propertyType  String?
  buildingArea  Float?
  floors        Int?
  status        String   @default("enquiry")
  systemCapacity Float?
  systemType    String?
  estimatedCost Float?
  customerPrice Float?
  progress      Int      @default(0)
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id])
  costs         ProjectCost[]
  payments      Payment[]
  quotations    Quotation[]
}

model ProjectCost {
  id             String  @id @default(cuid())
  category       String
  amount         Float
  description    String?
  breakdown      String?
  projectId      String
  project        Project @relation(fields: [projectId], references: [id])
  createdAt      DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  milestone     String
  expectedAmount Float
  paidAmount    Float    @default(0)
  status        String   @default("pending")
  paidAt        DateTime?
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Quotation {
  id           String   @id @default(cuid())
  equipment    Float
  installation Float
  engineering  Float
  otherCosts   Float    @default(0)
  subtotal     Float
  tax          Float    @default(0)
  discount     Float    @default(0)
  finalPrice   Float
  status       String   @default("draft")
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PriceConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  value       Float
  unit        String?
  updatedAt   DateTime @updatedAt
}

model SensorData {
  id              String   @id @default(cuid())
  groundTemp      Float
  systemTemp      Float
  flowRate        Float
  power           Float
  cop             Float
  status          String   @default("normal")
  projectId       String?
  timestamp       DateTime @default(now())
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  subject      String?
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}
